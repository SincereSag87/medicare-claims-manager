@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<section class="metric-grid">
    <article class="metric-card">
        <span>Patients</span>
        <strong>@Model.TotalPatients</strong>
    </article>
    <article class="metric-card">
        <span>Providers</span>
        <strong>@Model.TotalProviders</strong>
    </article>
    <article class="metric-card">
        <span>Open Claims</span>
        <strong>@Model.OpenClaims</strong>
    </article>
    <article class="metric-card">
        <span>Approved Value</span>
        <strong>@Model.ApprovedClaimValue.ToString("C")</strong>
    </article>
</section>

<section class="analytics-grid">
    <article class="workspace-panel">
        <div class="panel-heading">
            <div>
                <h2>Work Queue Snapshot</h2>
                <p>Seeded demo data immediately shows active, denied, paid, and approved work.</p>
            </div>
            <a class="btn btn-primary" asp-controller="Claims" asp-action="Index">View Claims</a>
        </div>
        <div class="financial-grid compact-financial-grid">
            <div>
                <span>Pending Value</span>
                <strong>@Model.PendingClaimValue.ToString("C")</strong>
            </div>
            <div>
                <span>Paid Claims</span>
                <strong>@Model.PaidClaims</strong>
            </div>
            <div>
                <span>Denied Claims</span>
                <strong>@Model.DeniedClaims</strong>
            </div>
        </div>
    </article>

    <article class="workspace-panel">
        <div class="panel-heading">
            <div>
                <h2>Recent Workflow</h2>
                <p>Latest status changes from the audit trail.</p>
            </div>
        </div>
        @if (Model.RecentWorkflowActivity.Any())
        {
            <div class="audit-list compact-audit-list">
                @foreach (var entry in Model.RecentWorkflowActivity)
                {
                    <article class="audit-entry">
                        <div>
                            <strong>@entry.Claim?.ClaimNumber</strong>
                            <span>@entry.OldValue to @entry.NewValue</span>
                        </div>
                        <small>@entry.ChangedAt.LocalDateTime.ToString("MMM d, h:mm tt")</small>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>No workflow activity</h3>
                <p>Status changes will appear after seeded or live claims move through review.</p>
            </div>
        }
    </article>
</section>

<section class="workspace-panel mt-3">
    <div class="panel-heading">
        <div>
            <h2>Recent Claim Activity</h2>
            <p>Claims needing review, documentation, approval, or payment follow-up.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="Index">View Reports</a>
    </div>

    @if (Model.RecentClaims.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Claim</th>
                        <th>Patient</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th class="text-end">Billed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model.RecentClaims)
                    {
                        <tr>
                            <td>@claim.ClaimNumber</td>
                            <td>@claim.Patient?.LastName, @claim.Patient?.FirstName</td>
                            <td>@claim.Provider?.OrganizationName</td>
                            <td><span class="status-pill">@claim.Status</span></td>
                            <td>@claim.Priority</td>
                            <td class="text-end">@claim.BilledAmount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No claim activity yet</h3>
            <p>Enable development seed data or create the first patient, provider, and claim records.</p>
        </div>
    }
</section>
