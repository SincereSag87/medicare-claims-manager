@model IEnumerable<Provider>

@{
    ViewData["Title"] = "Providers";
    var search = ViewData["Search"] as string;
}

<section class="workspace-panel">
    <div class="panel-heading">
        <div>
            <h2>Provider Directory</h2>
            <p>Provider organizations, NPI numbers, specialties, and claim relationships.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">Add Provider</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success" role="status">@statusMessage</div>
    }

    <form class="toolbar-form" asp-action="Index" method="get">
        <label class="visually-hidden" for="search">Search providers</label>
        <input id="search" class="form-control" name="search" value="@search" placeholder="Search by organization, NPI, specialty, or email" />
        <button class="btn btn-primary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Organization</th>
                    <th>NPI</th>
                    <th>Specialty</th>
                    <th>Contact</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var provider in Model)
                {
                    <tr>
                        <td>@provider.OrganizationName</td>
                        <td>@provider.Npi</td>
                        <td>@provider.Specialty</td>
                        <td>@provider.ContactEmail</td>
                        <td class="text-end action-links">
                            <a asp-action="Details" asp-route-id="@provider.Id">Details</a>
                            <a asp-action="Edit" asp-route-id="@provider.Id">Edit</a>
                            <a class="danger-link" asp-action="Delete" asp-route-id="@provider.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>No providers found</h3>
            <p>Add a provider record or adjust your search criteria.</p>
        </div>
    }
</section>
