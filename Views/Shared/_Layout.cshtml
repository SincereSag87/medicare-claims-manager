<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medicare Claims Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/medicare_claims_manager.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">M</span>
                <span>Claims Manager</span>
            </a>
            <nav class="sidebar-nav" aria-label="Primary navigation">
                <a asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-area="" asp-controller="Patients" asp-action="Index">Patients</a>
                <a asp-area="" asp-controller="Providers" asp-action="Index">Providers</a>
                <a asp-area="" asp-controller="Claims" asp-action="Index">Claims</a>
                <a asp-area="" asp-controller="Reports" asp-action="Index">Reports</a>
                <a asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div>
                    <div class="eyebrow">Revenue Cycle Operations</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <partial name="_LoginPartial" />
            </header>

            <main class="content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
