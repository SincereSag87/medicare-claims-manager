@model Claim

@{
    ViewData["Title"] = "Edit Claim";
}

<section class="workspace-panel narrow-panel">
    <div class="panel-heading">
        <div>
            <h2>Edit Claim</h2>
            <p>Update intake details, status, priority, and approved amount.</p>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_ClaimForm" model="Model" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save Changes</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
