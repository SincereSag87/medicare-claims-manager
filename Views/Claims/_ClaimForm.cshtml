@model Claim

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="form-grid">
    <div class="form-field">
        <label asp-for="ClaimNumber" class="form-label"></label>
        <input asp-for="ClaimNumber" class="form-control" autocomplete="off" />
        <span asp-validation-for="ClaimNumber" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="ServiceDate" class="form-label"></label>
        <input asp-for="ServiceDate" class="form-control" type="date" />
        <span asp-validation-for="ServiceDate" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="PatientId" class="form-label"></label>
        <select asp-for="PatientId" class="form-select" asp-items="ViewBag.PatientId">
            <option value="">Select patient</option>
        </select>
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="ProviderId" class="form-label"></label>
        <select asp-for="ProviderId" class="form-select" asp-items="ViewBag.ProviderId">
            <option value="">Select provider</option>
        </select>
        <span asp-validation-for="ProviderId" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="BilledAmount" class="form-label"></label>
        <input asp-for="BilledAmount" class="form-control" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="BilledAmount" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="ApprovedAmount" class="form-label"></label>
        <input asp-for="ApprovedAmount" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="ApprovedAmount" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ClaimStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="form-field">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<ClaimPriority>()"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="form-field full-width">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
</div>
