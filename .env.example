# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# SQL Server / Azure SQL
ConnectionStrings__DefaultConnection=Server=(localdb)\\mssqllocaldb;Database=MedicareClaimsManager_Dev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# First admin bootstrap. The Identity user must already exist.
AdminUser__Email=admin@example.com
